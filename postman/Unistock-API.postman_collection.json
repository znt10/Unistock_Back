        {
          "name": "Excluir item de pedido",
          "request": { "method": "DELETE", "header": [], "url": { "raw": "{{baseUrl}}/api/v1/itens-pedido/{{itemPedidoId}}/", "host": ["{{baseUrl}}"], "path": ["api", "v1", "itens-pedido", "{{itemPedidoId}}", ""] } }
        }
      ]
    },
    {
      "name": "Vendas (PDV)",
      "item": [
        {
          "name": "Finalizar venda",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"loja_id\": \"{{lojaId}}\",\n  \"itens\": [\n    { \"produto_id\": \"{{produtoId}}\", \"quantidade\": 1 }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/vendas/", "host": ["{{baseUrl}}"], "path": ["api", "v1", "vendas", ""] },
            "description": "loja_id e opcional pra Responsavel (usa a propria loja); obrigatorio pra Admin/Gerente. Da baixa direto no estoque."
          }
        }
      ]
    },
    {
      "name": "Notificacoes",
      "item": [
        {
          "name": "Listar notificacoes",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/v1/notificacoes/", "host": ["{{baseUrl}}"], "path": ["api", "v1", "notificacoes", ""] } }
        },
        {
          "name": "Detalhe da notificacao",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/v1/notificacoes/{{notificacaoId}}/", "host": ["{{baseUrl}}"], "path": ["api", "v1", "notificacoes", "{{notificacaoId}}", ""] } }
        },
        {
          "name": "Marcar como lida",
          "request": { "method": "PATCH", "header": [], "url": { "raw": "{{baseUrl}}/api/v1/notificacoes/{{notificacaoId}}/marcar-lida/", "host": ["{{baseUrl}}"], "path": ["api", "v1", "notificacoes", "{{notificacaoId}}", "marcar-lida", ""] } }
        },
        {
          "name": "Marcar todas como lidas",
          "request": { "method": "PATCH", "header": [], "url": { "raw": "{{baseUrl}}/api/v1/notificacoes/todas-lidas/", "host": ["{{baseUrl}}"], "path": ["api", "v1", "notificacoes", "todas-lidas", ""] } }
        },
        {
          "name": "Limpar notificacoes",
          "request": { "method": "DELETE", "header": [], "url": { "raw": "{{baseUrl}}/api/v1/notificacoes/limpar/", "host": ["{{baseUrl}}"], "path": ["api", "v1", "notificacoes", "limpar", ""] } }
        }
      ]
    },
    {
      "name": "Preferencias de Notificacao",
      "item": [
        {
          "name": "Ver preferencias",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/v1/preferencias-notificacao/me/", "host": ["{{baseUrl}}"], "path": ["api", "v1", "preferencias-notificacao", "me", ""] } }
        },
        {
          "name": "Atualizar preferencias",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email_ativo\": true,\n  \"whatsapp_ativo\": false,\n  \"telefone_whatsapp\": \"\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/preferencias-notificacao/me/", "host": ["{{baseUrl}}"], "path": ["api", "v1", "preferencias-notificacao", "me", ""] }
          }
        }
      ]
    },
    {
      "name": "Relatorio (PDF)",
      "item": [
        {
          "name": "Gerar relatorio de pedidos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/gerar_pdf/?periodo=dia&data=2026-08-01",
              "host": ["{{baseUrl}}"],
              "path": ["gerar_pdf", ""],
              "query": [
                { "key": "periodo", "value": "dia", "description": "dia | semana | mes" },
                { "key": "data", "value": "2026-08-01", "description": "opcional, AAAA-MM-DD" }
              ]
            },
            "description": "Restrito a Gerente/Admin — relatorio global de todas as lojas."
          }
        }
      ]
    },
    {
      "name": "Bot WhatsApp (Evolution API)",
      "item": [
        {
          "name": "Identificar loja pelo telefone (contato)",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Bot-Token", "value": "{{botToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/bot/contato/?telefone={{telefoneLoja}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "bot", "contato", ""],
              "query": [{ "key": "telefone", "value": "{{telefoneLoja}}" }]
            }
          }
        },
        {
          "name": "Catalogo",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Bot-Token", "value": "{{botToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/bot/catalogo/?telefone={{telefoneLoja}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "bot", "catalogo", ""],
              "query": [{ "key": "telefone", "value": "{{telefoneLoja}}" }]
            },
            "description": "Catalogo e por empresa: devolve so o produto/categoria do mesmo gerente da loja desse telefone."
          }
        },
        {
          "name": "Criar pedido",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-Bot-Token", "value": "{{botToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"telefone\": \"{{telefoneLoja}}\",\n  \"itens\": [\n    { \"codigo\": 1, \"quantidade\": 2 }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/bot/pedido/", "host": ["{{baseUrl}}"], "path": ["api", "v1", "bot", "pedido", ""] },
            "description": "'codigo' e o id inteiro do produto (o mesmo numero que aparece no catalogo)."
          }
        },
        {
          "name": "Confirmar pedido entregue",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-Bot-Token", "value": "{{botToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"telefone\": \"{{telefoneLoja}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/bot/pedido/{{pedidoNumero}}/confirmar/", "host": ["{{baseUrl}}"], "path": ["api", "v1", "bot", "pedido", "{{pedidoNumero}}", "confirmar", ""] }
          }
        },
        {
          "name": "Remover estoque (baixa manual)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-Bot-Token", "value": "{{botToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"telefone\": \"{{telefoneLoja}}\",\n  \"itens\": [\n    { \"codigo\": 1, \"quantidade\": 1 }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/bot/estoque/remover/", "host": ["{{baseUrl}}"], "path": ["api", "v1", "bot", "estoque", "remover", ""] }
          }
        },
        {
          "name": "Relatorio (so gerente)",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Bot-Token", "value": "{{botToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/bot/relatorio/?telefone={{telefoneGerente}}&periodo=dia",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "bot", "relatorio", ""],
              "query": [
                { "key": "telefone", "value": "{{telefoneGerente}}" },
                { "key": "periodo", "value": "dia", "description": "dia | semana | mes" }
              ]
            }
          }
        },
        {
          "name": "Webhook (simular mensagem da Evolution API)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"messages.upsert\",\n  \"data\": {\n    \"key\": {\n      \"remoteJid\": \"{{telefoneLoja}}@s.whatsapp.net\",\n      \"fromMe\": false\n    },\n    \"message\": {\n      \"conversation\": \"catalogo\"\n    }\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/bot/webhook/{{webhookToken}}/", "host": ["{{baseUrl}}"], "path": ["api", "v1", "bot", "webhook", "{{webhookToken}}", ""] },
            "description": "Nao chamado por voce em producao — a Evolution API que chama isso sozinha. Use pra simular/depurar sem precisar mandar WhatsApp de verdade. Comandos aceitos no 'conversation': catalogo, pedido <cod>x<qtd>, confirmar <numero>, remover <cod>x<qtd>."
          }
        }
      ]
    },
