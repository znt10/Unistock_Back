# Copie para .env e preencha. NUNCA commite o .env.

# Django
SECRET_KEY=troque-por-um-segredo-longo-aleatorio
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Admin padrao. O entrypoint roda "manage.py ensure_admin" no boot; sem estas
# duas o comando falha e o container sobe com o banco sem nenhum usuario.
# O ensure_admin e idempotente e redefine a senha a cada restart, entao pra
# trocar a senha do admin mude aqui, nao pelo /admin.
DJANGO_SUPERUSER_EMAIL=admin@unistock.local
DJANGO_SUPERUSER_PASSWORD=troque-por-uma-senha-forte

# Banco (sem DB_ENGINE definido, o settings cai no sqlite local)
DB_ENGINE=django.db.backends.mysql
DB_NAME=p5
DB_USER=root
DB_PASSWORD=12345
DB_HOST=localhost
DB_PORT=3306

# So pro docker-compose: senha do root do container MySQL. Tem que ser igual a
# DB_PASSWORD, senao o Django nao conecta. O compose aborta se estiver vazia.
# No compose o banco criado se chama "Unistock", entao DB_NAME acima precisa
# bater com isso quando rodar em container.
MYSQL_ROOT_PASSWORD=12345

# CORS / CSRF (separados por virgula)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://unistockteste.vercel.app
CSRF_TRUSTED_ORIGINS=http://localhost:3000,https://unistockteste.vercel.app

# Bot de WhatsApp (vazio = bot desativado)
BOT_SERVICE_TOKEN=
# Numero do gerente (recebe pedidos e pode pedir o PDF de todas as lojas)
GERENTE_WHATSAPP=

# Celery / Redis (no docker-compose o broker e sobrescrito para redis://redis:6379/0)
CELERY_BROKER_URL=redis://localhost:6379/0

# Email (em DEBUG os emails saem no console; producao usa SMTP)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Unistock <no-reply@unistock.local>

# URL do front (links de email, ex. confirmacao de conta)
FRONTEND_URL=http://localhost:3000

# Evolution API (bot de WhatsApp, nao-oficial)
EVOLUTION_API_KEY=          # senha que voce inventa - protege a API da Evolution
EVOLUTION_POSTGRES_PASSWORD= # senha que voce inventa - protege o banco da Evolution

