        {
          "name": "Schema OpenAPI (JSON)",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/schema/", "host": ["{{baseUrl}}"], "path": ["api", "schema", ""] } }
        }
