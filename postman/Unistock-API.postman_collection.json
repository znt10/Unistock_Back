{
  "info": {
    "_postman_id": "b6a1a0a0-2f0e-4b1a-9f2a-0f0b7c1d9a11",
    "name": "UniStock API",
    "description": "Colecao completa da API do UniStock (Unistock_Back). Pastas por dominio, na mesma ordem do README.\n\nAutenticacao: JWT em cookies HTTP-only. Rode 'Login' primeiro (pasta Autenticacao) — o Postman guarda o cookie automaticamente e reusa nas outras chamadas, desde que 'baseUrl' aponte sempre pro mesmo host.\n\nBot de WhatsApp: nao usa cookie, usa o header X-Bot-Token (variavel {{botToken}} = valor de BOT_SERVICE_TOKEN no .env).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000", "type": "string" },
    { "key": "email", "value": "", "type": "string" },
    { "key": "password", "value": "", "type": "string" },
    { "key": "botToken", "value": "", "type": "string" },
    { "key": "webhookToken", "value": "", "type": "string" },
    { "key": "telefoneLoja", "value": "", "type": "string" },
    { "key": "telefoneGerente", "value": "", "type": "string" },
    { "key": "userId", "value": "", "type": "string" },
    { "key": "gerenteId", "value": "", "type": "string" },
    { "key": "lojaId", "value": "", "type": "string" },
    { "key": "categoriaId", "value": "", "type": "string" },
    { "key": "produtoId", "value": "", "type": "string" },
    { "key": "estoqueId", "value": "", "type": "string" },
    { "key": "movimentacaoId", "value": "", "type": "string" },
    { "key": "pedidoId", "value": "", "type": "string" },
    { "key": "pedidoNumero", "value": "", "type": "string" },
    { "key": "itemPedidoId", "value": "", "type": "string" },
    { "key": "notificacaoId", "value": "", "type": "string" },
    { "key": "confirmarToken", "value": "", "type": "string" },
    { "key": "senhaToken", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Autenticacao",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/login/", "host": ["{{baseUrl}}"], "path": ["login", ""] },
            "description": "Entra e recebe os cookies access_token/refresh_token/role (HTTP-only). Rode antes das demais chamadas autenticadas."
          }
        },
        {
          "name": "Renovar token (refresh)",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/token/refresh/", "host": ["{{baseUrl}}"], "path": ["token", "refresh", ""] },
            "description": "Renova o access_token usando o refresh_token do cookie."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/logout/", "host": ["{{baseUrl}}"], "path": ["logout", ""] },
            "description": "Limpa os cookies access_token/refresh_token."
          }
        }
      ]
    },
    {
      "name": "Usuarios",
      "item": [
        {
          "name": "Meus dados (me)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/user/me/", "host": ["{{baseUrl}}"], "path": ["api", "v1", "user", "me", ""] }
          }
        },
        {
          "name": "Listar usuarios",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/user/", "host": ["{{baseUrl}}"], "path": ["api", "v1", "user", ""] },
            "description": "Escopo por get_queryset: Admin ve todos; Gerente ve so ele + responsaveis das lojas dele; Responsavel ve so ele mesmo."
          }
        },
        {
          "name": "Detalhe do usuario",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/user/{{userId}}/", "host": ["{{baseUrl}}"], "path": ["api", "v1", "user", "{{userId}}", ""] }
          }
        },
        {
          "name": "Atualizar usuario",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Novo nome\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/user/{{userId}}/", "host": ["{{baseUrl}}"], "path": ["api", "v1", "user", "{{userId}}", ""] }
          }
        },
        {
          "name": "Excluir usuario",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/user/{{userId}}/", "host": ["{{baseUrl}}"], "path": ["api", "v1", "user", "{{userId}}", ""] }
          }
        },
        {
          "name": "Registrar gerente (so Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Nome do Gerente\",\n  \"email\": \"gerente@exemplo.com\",\n  \"password\": \"senha-forte-123\",\n  \"tipo_usuario\": \"gerente\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/user/registrar/", "host": ["{{baseUrl}}"], "path": ["api", "v1", "user", "registrar", ""] },
            "description": "Exclusivo do Admin. Responsavel de loja NAO se cria aqui — nasce junto com a Loja, a partir do email dela."
          }
        },
        {
          "name": "Estrutura (Gerente -> Lojas)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/user/estrutura/", "host": ["{{baseUrl}}"], "path": ["api", "v1", "user", "estrutura", ""] },
            "description": "Arvore Gerente -> Lojas -> Responsavel, so Admin."
          }
        },
        {
          "name": "Confirmar conta (link do email)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/user/confirmar/{{confirmarToken}}/", "host": ["{{baseUrl}}"], "path": ["api", "v1", "user", "confirmar", "{{confirmarToken}}", ""] }
          }
        },
        {
          "name": "Esqueci a senha",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/user/esqueci-senha/", "host": ["{{baseUrl}}"], "path": ["api", "v1", "user", "esqueci-senha", ""] },
            "description": "Sempre responde 200 (exista ou nao o email) para nao revelar quais contas existem."
          }
        },
        {
          "name": "Definir senha (link do email)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"senha-forte-123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/user/definir-senha/{{senhaToken}}/", "host": ["{{baseUrl}}"], "path": ["api", "v1", "user", "definir-senha", "{{senhaToken}}", ""] }
          }
        }
      ]
    },
    {
