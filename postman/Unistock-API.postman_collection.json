      "name": "Documentacao (schema)",
      "item": [
        {
          "name": "Swagger UI",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/api/schema/swagger/", "host": ["{{baseUrl}}"], "path": ["api", "schema", "swagger", ""] } }
